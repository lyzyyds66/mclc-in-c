# Normalize text files in the repository.
* text=auto

*.c            text eol=lf
*.h            text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
Makefile       text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf

*.exe          binary
*.dll          binary
*.lib          binary
*.zip          binary
*.png          binary
*.ico          binary
